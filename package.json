{
	"name": "wxt-tailwind-template",
	"description": "Browser extension template",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": "^22.18.0 || ^24.11.0 || >=26.0.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.0.0",
			"onFail": "ignore"
		}
	},
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"check": "vp check --fix",
		"postinstall": "wxt prepare",
		"bumpp": "bumpp --no-push --yes"
	},
	"dependencies": {
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@commitlint/types": "21.2.3",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "26.6.10",
		"@types/react": "19.3.3",
		"@types/react-dom": "19.3.0",
		"@wxt-dev/module-react": "1.2.2",
		"bumpp": "12.3.0",
		"lefthook": "2.2.3",
		"tailwindcss": "4.3.5",
		"vite-plus": "catalog:",
		"web-ext": "10.8.0",
		"wxt": "0.21.5"
	}
}
